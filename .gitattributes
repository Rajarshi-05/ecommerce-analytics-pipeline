# Normalise line endings. This repo is developed on Windows but every script in
# it runs inside a Linux container, so anything with a shebang or anything read
# by a Linux tool must be stored and checked out with LF. A CRLF shell script
# fails on Linux with "bad interpreter: /usr/bin/env bash^M", and a CRLF
# Dockerfile or entrypoint fails the same way.
* text=auto eol=lf

# Explicitly LF regardless of platform.
*.sh            text eol=lf
*.py            text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.json          text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf
.env.example    text eol=lf
.gitignore      text eol=lf
.dockerignore   text eol=lf

# Binary - never touch.
*.parquet       binary
*.png           binary
*.jpg           binary
*.zip           binary

# Keep generated dbt artefacts and the dashboard snapshot out of diffs; they are
# regenerated by the pipeline and the noise buries real changes in review.
dashboard/data/*.parquet   linguist-generated=true
dbt_project/target/**      linguist-generated=true
