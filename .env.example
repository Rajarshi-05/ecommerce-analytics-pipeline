# Copy to .env before running `docker compose up`.
#   cp .env.example .env

# ---------------------------------------------------------------- warehouse --
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=ecommerce
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port exposed on the host. Change if 5432 is already taken locally.
POSTGRES_HOST_PORT=5433

# Consumed by ingestion / ML / dashboard containers.
DATABASE_URL=postgresql+psycopg2://analytics:analytics@postgres:5432/ecommerce

# ------------------------------------------------------------------ airflow --
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_WEB_PORT=8080
# Concurrent slots for the memory-bound ML tasks. 1 keeps them serialised so
# they can't OOM a laptop; raise it if you have RAM to spare.
ML_POOL_SLOTS=1
AIRFLOW_PARALLELISM=4

# ---------------------------------------------------------- memory budget --
# Caps so the stack cannot starve the host. These suit a ~6 GB machine; raise
# them if you have more. Docker Desktop users: also check the RAM allocated to
# the VM in Settings > Resources, since these limits sit inside that budget.
POSTGRES_MEM_LIMIT=1g
AIRFLOW_MEM_LIMIT=2g
APP_MEM_LIMIT=768m
# Generate your own: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=UKMzEMjTuJHb6xoBMwZVy8kFAdBSAcAgcRRXlBiSSGE=

# ------------------------------------------------------------------- kaggle --
# From kaggle.com > Settings > API > "Create New Token" (downloads kaggle.json).
# Either set these two vars, or drop kaggle.json in the repo root / ~/.kaggle/.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ------------------------------------------------------------------ services --
DASHBOARD_PORT=8501
API_PORT=8000

# Rows to keep per table when INGEST_SAMPLE_MODE=true (fast local smoke runs).
INGEST_SAMPLE_MODE=false
INGEST_SAMPLE_ROWS=5000
